# development | production
NODE_ENV=development

# PostgreSQL (see docker-compose.yml at the repo root)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockflow?schema=public"

# Secret used to sign JWT access tokens. In production it must have at least
# 32 characters; generate one with: openssl rand -base64 48
JWT_SECRET="change-me"

# HTTP port for the API
PORT=3000

# Number of proxies in front of the API that set X-Forwarded-For (the Next.js
# server counts as one). Leave empty when the API is reachable directly from the
# internet, otherwise clients could spoof their IP to dodge rate limits.
TRUST_PROXY=

# Browser origins allowed by CORS, comma-separated. The frontend calls the API
# from its server, so this can stay empty.
FRONTEND_URL=

# Swagger UI at /docs is always on in development; set to true to also serve it
# in production.
SWAGGER_ENABLED=false
