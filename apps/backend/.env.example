# PostgreSQL (see docker-compose.yml at the repo root)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockflow?schema=public"

# Secret used to sign JWT access tokens. Use a long random value in production.
JWT_SECRET="change-me"

# HTTP port for the API
PORT=3000

# Allowed CORS origins, comma-separated
FRONTEND_URL="http://localhost:5173"
